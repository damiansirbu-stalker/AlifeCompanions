--- zzz_ac_mcm: MCM configuration - per-companion toggles and teleport buttons

local data = zzz_ac_data

local pairs, RegisterScriptCallback = pairs, RegisterScriptCallback

local KEY_DEBUG_LOG = "debug_log"

defaults = {
    debug_log = false,
}

local _prefix_to_companion = {}
for companion_id, _ in pairs(data.COMPANIONS) do
    defaults[companion_id .. "_enabled"] = true
    defaults[companion_id .. "_auto_spawn"] = true
    _prefix_to_companion[companion_id .. "_"] = companion_id
end

local build_path = function(key)
    if key == KEY_DEBUG_LOG then
        return "sc/general/" .. key
    end
    for prefix, companion_id in pairs(_prefix_to_companion) do
        if key:sub(1, #prefix) == prefix then
            local setting = key:sub(#prefix + 1)
            return "sc/" .. companion_id .. "/" .. setting
        end
    end
    return "sc/" .. key
end
cfg, get_config, load_config = xmcm.create_config("ac", defaults, build_path)

--- Teleport the companion to the player.
function btn_teleport_to_player(companion_id)
    if zzz_ac and zzz_ac.teleport_to_player then
        zzz_ac.teleport_to_player(companion_id)
    end
end

--- Teleport the player to the companion.
function btn_go_to_companion(companion_id)
    if zzz_ac and zzz_ac.teleport_to_companion then
        zzz_ac.teleport_to_companion(companion_id)
    end
end

--- Clear the companion's permadeath flag (debug).
function btn_reset_death(companion_id)
    if not (zzz_ac and zzz_ac.reset_death) then return end
    zzz_ac.reset_death(companion_id)
    if not db.actor then return end
    local companion = data.COMPANIONS[companion_id]
    local msg = (companion and companion.display_name or companion_id) .. " death status reset."
    news_manager.send_tip(db.actor, msg, nil, nil, 5000)
end

function on_mcm_load()
    local gr = {
        {
            id = "general",
            sh = true,
            gr = {
                { id = "title", type = "slide", link = "ac_mcm_banner", text = "ui_mcm_ac_title", size = {512, 50}, spacing = 20 },
                { id = "desc", type = "desc", text = "ui_mcm_ac_general_desc" },

                { id = "div_debug", type = "line" },
                { id = "hdr_debug", type = "desc", text = "ui_mcm_ac_hdr_debug", clr = {255, 200, 200, 200} },
                { id = "debug_log", type = "check", val = 1, def = false },
                { id = "div_version", type = "line" },
                { id = "version", type = "desc", text = "ui_mcm_ac_hdr_debug",
                    ui_hook_functor = { zzz_ac_mcm.set_version_text }, clr = {255, 212, 201, 168} },
            },
        },
    }

    for companion_id, companion in pairs(data.COMPANIONS) do
        local tab = {
            id = companion_id,
            sh = true,
            gr = {
                { id = "title", type = "slide", link = "ac_mcm_banner", text = "ui_mcm_ac_" .. companion_id .. "_title", size = {512, 50}, spacing = 20 },
                { id = "desc", type = "desc", text = "ui_mcm_ac_" .. companion_id .. "_desc" },

                { id = "div_main", type = "line" },
                { id = "hdr_main", type = "desc", text = "ui_mcm_ac_hdr_settings", clr = {255, 200, 200, 200} },
                { id = "enabled", type = "check", val = 1, def = true },
                { id = "auto_spawn", type = "check", val = 1, def = true },

                { id = "div_actions", type = "line" },
                { id = "hdr_actions", type = "desc", text = "ui_mcm_ac_hdr_actions", clr = {255, 200, 200, 200} },
                { id = "btn_teleport", type = "button", functor = { btn_teleport_to_player, companion_id } },
                { id = "btn_goto", type = "button", functor = { btn_go_to_companion, companion_id } },

                { id = "div_debug", type = "line" },
                { id = "hdr_debug_actions", type = "desc", text = "ui_mcm_ac_hdr_debug_actions", clr = {255, 200, 200, 200} },
                { id = "btn_reset_death", type = "button", functor = { btn_reset_death, companion_id } },
            },
        }
        gr[#gr+1] = tab
    end

    return { id = "sc", gr = gr }
end

function set_version_text(_anchor, handlers)
    handlers.desc:SetText(_ac_init.get_version())
end

function on_game_start()
    load_config()
    RegisterScriptCallback("on_option_change", load_config)
    RegisterScriptCallback("mcm_option_restore_default", load_config)
end
